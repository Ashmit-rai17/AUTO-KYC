# Copy to .env and fill in. NEVER commit .env (AGENTS.md invariant 8).

NODE_ENV=development
PORT=4000

# Must match docker-compose.yml when using the local database.
DATABASE_URL=postgres://kycflow:kycflow@localhost:5432/kycflow

# Session cookie (docs/adr/session-cookies.md)
SESSION_COOKIE_NAME=kyc_session
SESSION_TTL_HOURS=8

# Providers. M0 runs entirely on mocks (docs/provider-adapters.md).
PAN_PROVIDER=mock
OCR_PROVIDER=mock
STORAGE_PROVIDER=mock

# AGENTS.md invariant 10. With NODE_ENV=production the API REFUSES to start
# while any provider above is a simulator, because a simulated verdict issued
# against a real person's documents must never be possible by accident. Set
# this to true only to state deliberately that a deployment is a demonstration.
ALLOW_MOCK_PROVIDERS_IN_PROD=false

# Real storage credentials — leave blank until M2. Backend only.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Front ends only. Each Next.js app proxies /api/* to this origin through a
# rewrite (ADR-005), so the browser still sees ONE origin and the session
# cookie stays first-party. Leave unset for local development, where it
# defaults to http://localhost:4000.
# API_ORIGIN=https://your-api.onrender.com
