# Copy to .env and fill in. NEVER commit .env (AGENTS.md invariant 8).

NODE_ENV=development
PORT=4000

# Must match docker-compose.yml when using the local database.
DATABASE_URL=postgres://kycflow:kycflow@localhost:5432/kycflow

# Session cookie (docs/adr/session-cookies.md)
SESSION_COOKIE_NAME=kyc_session
SESSION_TTL_HOURS=8

# Providers. M0 runs entirely on mocks (docs/provider-adapters.md).
PAN_PROVIDER=mock
OCR_PROVIDER=mock
STORAGE_PROVIDER=mock

# Real storage credentials — leave blank until M2. Backend only.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
